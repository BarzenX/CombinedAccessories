# This file will automatically update with entries for new content after a build and reload

Items: {
	AncientTerraBlade: {
		DisplayName: Ancient Terra Blade
		Tooltip:
			'''
			Shoots old {$ItemName.TerraBlade} beams
			"The child of the great blade, with a marking resemblance to the ol' reliable"
			'''
	}

	VitalityShield: {
		DisplayName: Vitality Shield
		Tooltip:
			'''
			Combined effects of {$ItemName.AnkhShield}, {$ItemName.CharmofMyths}, {$ItemName.HeroShield} and {$ItemName.PutridScent}
			10% increased damage and critical strike chance
			Enemies are not less or more likely to target you

			"Contains instructions for CPR"
			'''
	}

	MobilityBoots: {
		DisplayName: Mobility Boots
		Tooltip:
			'''
			Combined effects of {$ItemName.Tabi}, {$ItemName.FrogGear}, {$ItemName.LuckyHorseshoe} and {$ItemName.TerrasparkBoots}
			Provides imunity to lava

			"Weirdly silent..."
			'''
	}

	CelestialGloves: {
		DisplayName: Celestial Gloves
		Tooltip:
			'''
			Combined effects of {$ItemName.FireGauntlet}, {$ItemName.EyeoftheGolem} and {$ItemName.FleshKnuckles}
			Increases melee knockback
			12% increased damage and speed
			8% increased critical strike chance

			"Strangely comfortable for combat gloves"
			'''
	}

	GodslayerGear: {
		DisplayName: Godslayer Gear
		Tooltip:
			'''
			Combined effects of {$Mods.CombinedAccessories.Items.MobilityBoots.DisplayName}, {$Mods.CombinedAccessories.Items.VitalityShield.DisplayName}, {$Mods.CombinedAccessories.Items.CelestialGloves.DisplayName}, {$ItemName.HandOfCreation} and {$ItemName.EmpressFlightBooster}
			Everything you could ever need, in a single accessory slot!
			Increases melee knockback
			20% increased damage
			12% increased speed
			16% increased critical strike chance

			"{$ItemName.PortableStool} not included"
			'''
	}
}
